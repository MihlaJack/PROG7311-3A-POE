@model ServiceRequestViewModel
@{
    ViewData["Title"] = $"Request {Model.RequestNumber}";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="mb-1">
            <i class="bi bi-truck me-2"></i>@Model.RequestNumber
            @switch (Model.Status)
            {
                case "Pending":
                    <span class="badge bg-warning text-dark">@Model.Status</span>
                    break;
                case "Approved":
                    <span class="badge bg-info">@Model.Status</span>
                    break;
                case "InProgress":
                    <span class="badge bg-primary">@Model.Status</span>
                    break;
                case "Completed":
                    <span class="badge bg-success">@Model.Status</span>
                    break;
                case "Cancelled":
                    <span class="badge bg-secondary">@Model.Status</span>
                    break;
            }
        </h2>
        <p class="text-muted mb-0">@Model.ClientName - @Model.ContractNumber</p>
    </div>
    <div class="col-md-4 text-md-end">
        <a href="/ServiceRequests" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Request Details</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Service Type</label>
                        <p class="fw-medium"><span class="badge bg-secondary">@Model.Type</span></p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Contract</label>
                        <p class="fw-medium"><a href="/Contracts/Details/@Model.ContractId">@Model.ContractNumber</a></p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Estimated Cost</label>
                        <p class="fw-medium">@(Model.EstimatedCost?.ToString("C") ?? "N/A")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Actual Cost</label>
                        <p class="fw-medium">@(Model.ActualCost?.ToString("C") ?? "Pending")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Request Date</label>
                        <p class="fw-medium">@Model.RequestDate.ToString("MMMM dd, yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Scheduled Date</label>
                        <p class="fw-medium">@(Model.ScheduledDate?.ToString("MMMM dd, yyyy") ?? "Not scheduled")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Pickup Location</label>
                        <p class="fw-medium">@(Model.PickupLocation ?? "Not specified")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Delivery Location</label>
                        <p class="fw-medium">@(Model.DeliveryLocation ?? "Not specified")</p>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small">Description</label>
                        <p class="fw-medium">@(Model.Description ?? "No description provided")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Actions</h5>
            </div>
            <div class="card-body">
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    @if (Model.Status == "Pending")
                    {
                        <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle me-2"></i>Approve Request
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Approved" || Model.Status == "InProgress")
                    {
                        <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <input type="number" name="actualCost" class="form-control" placeholder="Actual cost (optional)" step="0.01" />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-check-all me-2"></i>Complete Request
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Pending" || Model.Status == "Approved" || Model.Status == "InProgress")
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="bi bi-x-circle me-2"></i>Cancel Request
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Pending")
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this request?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-trash me-2"></i>Delete Request
                            </button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>