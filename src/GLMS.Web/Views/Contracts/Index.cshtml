@model PagedContractsViewModel
@{
    ViewData["Title"] = "Contracts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-file-text me-2"></i>Contracts</h2>
        <p class="text-muted mb-0">Manage logistics contracts</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a href="/Contracts/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Contract
        </a>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <input type="text" name="SearchTerm" class="form-control" placeholder="Search contracts..." 
                       value="@Context.Request.Query["SearchTerm"]" />
            </div>
            <div class="col-md-2">
                <select name="Status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Draft" selected='@(Context.Request.Query["Status"] == "Draft" ? "selected" : "")'>Draft</option>
                    <option value="Active" selected='@(Context.Request.Query["Status"] == "Active" ? "selected" : "")'>Active</option>
                    <option value="Expired" selected='@(Context.Request.Query["Status"] == "Expired" ? "selected" : "")'>Expired</option>
                    <option value="OnHold" selected='@(Context.Request.Query["Status"] == "OnHold" ? "selected" : "")'>On Hold</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="Type" class="form-select">
                    <option value="">All Types</option>
                    <option value="Freight" selected='@(Context.Request.Query["Type"] == "Freight" ? "selected" : "")'>Freight</option>
                    <option value="Warehousing" selected='@(Context.Request.Query["Type"] == "Warehousing" ? "selected" : "")'>Warehousing</option>
                    <option value="ExpressDelivery" selected='@(Context.Request.Query["Type"] == "ExpressDelivery" ? "selected" : "")'>Express Delivery</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-primary me-2">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
                <a href="/Contracts" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="table-container">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Contract #</th>
                    <th>Client</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Status</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Requests</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contract in Model.Items)
                {
                    <tr>
                        <td>
                            <a href="/Contracts/Details/@contract.Id" class="text-decoration-none fw-medium">
                                @contract.ContractNumber
                            </a>
                        </td>
                        <td>
                            <div class="fw-medium">@contract.ClientName</div>
                            <small class="text-muted">@contract.ClientEmail</small>
                        </td>
                        <td><span class="badge bg-secondary">@contract.Type</span></td>
                        <td>@contract.ContractValue.ToString("C") @contract.Currency</td>
                        <td><span class="badge-status status-@contract.Status">@contract.Status</span></td>
                        <td>@contract.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>@contract.EndDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="badge bg-info">@contract.ServiceRequestCount</span>
                        </td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                    Actions
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Contracts/Details/@contract.Id"><i class="bi bi-eye me-2"></i>View</a></li>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                    {
                                        @if (contract.Status == "Draft")
                                        {
                                            <li>
                                                <form asp-action="Activate" asp-route-id="@contract.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-2"></i>Activate</button>
                                                </form>
                                            </li>
                                        }
                                        @if (contract.Status == "Active")
                                        {
                                            <li>
                                                <form asp-action="Expire" asp-route-id="@contract.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-warning"><i class="bi bi-x-circle me-2"></i>Expire</button>
                                                </form>
                                            </li>
                                        }
                                        @if (contract.Status == "Draft")
                                        {
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@contract.Id" method="post" class="d-inline" 
                                                      onsubmit="return confirm('Are you sure you want to delete this contract?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                                                </form>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)&pageSize=@Model.PageSize">Previous</a>
                    </li>
                }
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="?pageNumber=@i&pageSize=@Model.PageSize">@i</a>
                    </li>
                }
                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)&pageSize=@Model.PageSize">Next</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>