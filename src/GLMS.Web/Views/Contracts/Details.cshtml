@model ContractViewModel
@{
    ViewData["Title"] = $"Contract {Model.ContractNumber}";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="mb-1">
            <i class="bi bi-file-text me-2"></i>@Model.ContractNumber
            <span class="badge-status status-@Model.Status ms-2">@Model.Status</span>
        </h2>
        <p class="text-muted mb-0">@Model.ClientName</p>
    </div>
    <div class="col-md-4 text-md-end">
        <a href="/Contracts" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Contract Details</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Client Name</label>
                        <p class="fw-medium">@Model.ClientName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Client Email</label>
                        <p class="fw-medium">@Model.ClientEmail</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Client Phone</label>
                        <p class="fw-medium">@Model.ClientPhone</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Contract Type</label>
                        <p class="fw-medium"><span class="badge bg-secondary">@Model.Type</span></p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Contract Value</label>
                        <p class="fw-medium fs-5 text-primary">@Model.ContractValue.ToString("C") @Model.Currency</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Service Requests</label>
                        <p class="fw-medium"><span class="badge bg-info">@Model.ServiceRequestCount</span></p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Start Date</label>
                        <p class="fw-medium">@Model.StartDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">End Date</label>
                        <p class="fw-medium">@Model.EndDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small">Description</label>
                        <p class="fw-medium">@(Model.Description ?? "No description provided")</p>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small">Service Level Agreement</label>
                        <p class="fw-medium">@(Model.ServiceLevelAgreement ?? "No SLA defined")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Actions</h5>
            </div>
            <div class="card-body">
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    @if (Model.Status == "Draft")
                    {
                        <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle me-2"></i>Activate Contract
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Active")
                    {
                        <form asp-action="Expire" asp-route-id="@Model.Id" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="bi bi-x-circle me-2"></i>Expire Contract
                            </button>
                        </form>
                    }
                    @if (Model.Status == "Draft")
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mb-2"
                              onsubmit="return confirm('Are you sure you want to delete this contract?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-trash me-2"></i>Delete Contract
                            </button>
                        </form>
                    }
                }
                <a href="/ServiceRequests/Create?contractId=@Model.Id" class="btn btn-primary w-100">
                    <i class="bi bi-plus-lg me-2"></i>New Service Request
                </a>
            </div>
        </div>
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Timeline</h5>
            </div>
            <div class="card-body">
                <div class="d-flex mb-2">
                    <div class="text-muted small me-2">Created:</div>
                    <div>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="d-flex">
                        <div class="text-muted small me-2">Updated:</div>
                        <div>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>