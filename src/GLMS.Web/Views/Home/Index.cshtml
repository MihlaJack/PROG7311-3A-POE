@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="display-5 fw-bold text-primary">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </h1>
        <p class="text-muted">Global Logistics Management System Overview</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Total Contracts</h6>
                        <h3 class="mb-0">@Model.TotalContracts</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded">
                        <i class="bi bi-file-text fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Active Contracts</h6>
                        <h3 class="mb-0 text-success">@Model.ActiveContracts</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded">
                        <i class="bi bi-check-circle fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Expiring Soon</h6>
                        <h3 class="mb-0 text-warning">@Model.ExpiringContracts</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded">
                        <i class="bi bi-exclamation-triangle fs-2 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card danger">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Pending Requests</h6>
                        <h3 class="mb-0 text-danger">@Model.TotalPendingRequests</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded">
                        <i class="bi bi-clock-history fs-2 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Recent Contracts</h5>
                <a href="/Contracts" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Contract #</th>
                                <th>Client</th>
                                <th>Type</th>
                                <th>Value</th>
                                <th>Status</th>
                                <th>End Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contract in Model.RecentContracts)
                            {
                                <tr>
                                    <td>
                                        <a href="/Contracts/Details/@contract.Id" class="text-decoration-none fw-medium">
                                            @contract.ContractNumber
                                        </a>
                                    </td>
                                    <td>@contract.ClientName</td>
                                    <td>
                                        <span class="badge bg-secondary">@contract.Type</span>
                                    </td>
                                    <td>@contract.ContractValue.ToString("C") @contract.Currency</td>
                                    <td>
                                        <span class="badge-status status-@contract.Status">@contract.Status</span>
                                    </td>
                                    <td>@contract.EndDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-truck me-2"></i>Pending Requests</h5>
            </div>
            <div class="card-body">
                @if (Model.PendingRequests.Any())
                {
                    @foreach (var request in Model.PendingRequests.Take(5))
                    {
                        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                            <div class="bg-warning bg-opacity-10 p-2 rounded me-3">
                                <i class="bi bi-clock text-warning"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@request.RequestNumber</h6>
                                <small class="text-muted">@request.ClientName - @request.Type</small>
                            </div>
                            <a href="/ServiceRequests/Details/@request.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </div>
                    }
                    <a href="/ServiceRequests/Pending" class="btn btn-outline-primary w-100">View All Pending</a>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-check-circle fs-1 text-success mb-2"></i>
                        <p>No pending requests</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>